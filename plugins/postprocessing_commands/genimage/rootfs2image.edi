set -o errexit
set -o pipefail
set -o nounset

source "{{ pp_timestamp }}"

LOG_LEVEL="{{ edi_log_level }}"
PLUGIN_DIRECTORY="{{ edi_current_plugin_directory }}"
DISK_IMAGE="{{ pp_image }}"
PARTITION_IMAGE="{{ pp_partition_image }}"
WORKDIR="{{ edi_work_directory }}"
HOSTNAME="{{ hostname }}"
ARTIFACT_NAME="${BUILD_TIMESTAMP}-{{ edi_configuration_name }}-{{ debian_distribution_release }}-{{ edi_bootstrap_architecture }}"
MENDER_DEVICE_TYPE="{{ mender_device_type }}"

print_error()
{
    local MESSAGE="${1}"
    >&2 echo -e "\033[91mError: ${MESSAGE}\033[0m"
}

print_error_and_exit()
{
    local MESSAGE="${1}"
    print_error "${MESSAGE}"
    exit 1
}

unexpected_exit()
{
    local TEMPDIR="${1}"
    print_error "Going to clean up after abnormal script termination."
    rm -rf "${TEMPDIR}"
    trap - EXIT
    print_error_and_exit "Abnormal script termination."
}

if [ "${LOG_LEVEL}" == "DEBUG" ]; then
    set -x
fi

if touch /etc/edi-root-check > /dev/null 2>&1; then
    print_error_and_exit "This script must not be run as real root - please use fakeroot or unshare."
fi

if [[ ${EUID} -ne 0 ]]; then
    print_error_and_exit "This script must be run using fakeroot or unshare."
fi

if [ -z "${edi_project_container_root:-}" ]; then
    print_error_and_exit "Missing environment variable 'edi_project_container_root'."
fi

TEMPDIR="$(mktemp -p "${WORKDIR}" -d -t .tmp.XXXXXXXX)"
trap "unexpected_exit ${TEMPDIR}" EXIT

pushd "${TEMPDIR}" > /dev/null

ROOTFS_DIR="rootfs/factory"
mkdir -p "${ROOTFS_DIR}"

rsync --numeric-ids --exclude-from "${PLUGIN_DIRECTORY}/exclude-patterns" --xattrs --acls --atimes --hard-links --archive "${edi_project_container_root}/" "${ROOTFS_DIR}"/

# Copy kernel, initrd and dtbs to firmware partition
if [ -d "${ROOTFS_DIR}/boot/image-kernel" ]; then
    cp -r -L "${ROOTFS_DIR}"/boot/image-kernel "${ROOTFS_DIR}"/boot/firmware/p3
    sed -i "s@^BOOTLOADER_DIRECTORY=.*@BOOTLOADER_DIRECTORY=\"/boot/firmware/p3\"@" "${ROOTFS_DIR}/etc/edi-boot-shim/edi-boot-shim.cfg.d/multiboot.cfg"
fi

if [ -d "${ROOTFS_DIR}/boot/image-firmware" ]; then
    cp "${ROOTFS_DIR}"/boot/image-firmware/cmdline.txt "${ROOTFS_DIR}"/boot/firmware/p3/cmdline.txt
    sed -i 's@__ROOTFS_PARTITION__@3@' "${ROOTFS_DIR}"/boot/firmware/p3/cmdline.txt
    cp "${ROOTFS_DIR}"/boot/image-firmware/config.txt "${ROOTFS_DIR}"/boot/firmware/config.txt
    sed -i 's@__ROOTFS_PARTITION__@3@' "${ROOTFS_DIR}"/boot/firmware/config.txt
    if [ "${MENDER_DEVICE_TYPE}" == "pi3-v3" ]; then
        cp "${ROOTFS_DIR}"/boot/image-firmware/bootcode.bin "${ROOTFS_DIR}"/boot/firmware/bootcode.bin
        cp "${ROOTFS_DIR}"/boot/image-firmware/start.elf "${ROOTFS_DIR}"/boot/firmware/p3start.elf
        cp "${ROOTFS_DIR}"/boot/image-firmware/fixup.dat "${ROOTFS_DIR}"/boot/firmware/p3fixup.dat
    elif [ "${MENDER_DEVICE_TYPE}" == "pi4-v3" ]; then
        cp "${ROOTFS_DIR}"/boot/image-firmware/start4.elf "${ROOTFS_DIR}"/boot/firmware/p3start4.elf
        cp "${ROOTFS_DIR}"/boot/image-firmware/fixup4.dat "${ROOTFS_DIR}"/boot/firmware/p3fixup4.dat
    fi
fi

# Remove /etc/machine-id and /var/lib/dbus/machine-id (it should be unique for each system).
rm "${ROOTFS_DIR}"/etc/machine-id
rm "${ROOTFS_DIR}"/var/lib/dbus/machine-id
# Add fstab.
cp "${PLUGIN_DIRECTORY}/fstab" "${ROOTFS_DIR}"/etc/

# Add artifact information to rootfs.
mkdir -p "${ROOTFS_DIR}/etc/mender/"
echo "artifact_name=${ARTIFACT_NAME}" > "${ROOTFS_DIR}"/etc/mender/artifact_info

# Adjust hostname.
cp "${PLUGIN_DIRECTORY}/hosts" "${ROOTFS_DIR}"/etc/
chmod 0644 "${ROOTFS_DIR}"/etc/hosts
sed -i "s@__HOSTNAME__@${HOSTNAME}@" "${ROOTFS_DIR}"/etc/hosts
cp "${PLUGIN_DIRECTORY}/hostname" "${ROOTFS_DIR}"/etc/
sed -i "s@__HOSTNAME__@${HOSTNAME}@" "${ROOTFS_DIR}"/etc/hostname

genimage --rootpath rootfs --config "${PLUGIN_DIRECTORY}/genimage.cfg" --tmppath genimage-workdir

popd > /dev/null

mv "${TEMPDIR}/images/disk-image.img" "${DISK_IMAGE}"
mv "${TEMPDIR}/images/root.btrfs" "${PARTITION_IMAGE}"

rm -rf "${TEMPDIR}"
trap - EXIT
