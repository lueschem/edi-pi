set -o nounset
set -o errexit
set -o pipefail

print_error_and_exit()
{
    local MESSAGE=$1
    >&2 echo "error: ${MESSAGE}"
    exit 1
}

if [[ $EUID -ne 0 ]]; then
    print_error_and_exit "use root user to execute this script"
fi

CURRENT_BOOT_DEVICE=$(mount | sed -n 's|^/dev/\(.*\) on / .*|\1|p')
if [ -z "${CURRENT_BOOT_DEVICE}" ] ; then
    print_error_and_exit "unable to detect root partition device"
fi

CURRENT_BOOT_PART=$(echo "${CURRENT_BOOT_DEVICE}" | grep -o '[1-9][0-9]*$')
if [ -z "${CURRENT_BOOT_PART}" ] ; then
    print_error_and_exit "unable to extract partition number of ${CURRENT_BOOT_DEVICE}"
fi

sed -i "s@^BOOTLOADER_DIRECTORY=.*@BOOTLOADER_DIRECTORY=\"/boot/firmware/p${CURRENT_BOOT_PART}\"@" "/etc/edi-boot-shim/edi-boot-shim.cfg.d/multiboot.cfg"